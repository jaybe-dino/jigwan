# 지관 외부 API 키 (.env 로 복사 후 채우기 · .env 는 커밋 금지)
# 키가 없으면 파이프라인은 픽스처(데모 샘플)로 폴백한다.

# 카카오 로컬 — 주소 지오코딩 + 주변 POI (필수: 실주소 감정)
KAKAO_REST_KEY=

# 브이월드 — 도로·하천·건물 폴리곤(좌향 추정)
VWORLD_KEY=

# 공공데이터포털 — 건축물대장(층수)·실거래가
DATA_GO_KR_KEY=

# PostGIS
JIGWAN_DATABASE_URL=postgresql://jigwan:jigwan@localhost:5432/jigwan
